%% Modern web application architecture
%% Render with Mermaid Live, GitHub, GitLab, VS Code, or Obsidian.
---
config:
  theme: base
  themeVariables:
    primaryColor: "#e8f1ff"
    primaryTextColor: "#10233f"
    primaryBorderColor: "#3973c6"
    lineColor: "#52657a"
    secondaryColor: "#eefbf4"
    tertiaryColor: "#fff7e6"
---
flowchart LR
    User([Web / Mobile User])

    subgraph Edge[Edge & Delivery]
        DNS[DNS]
        CDN[CDN / Static Assets]
        WAF[WAF + DDoS Protection]
    end

    subgraph Client[Client Layer]
        Web[Web App
        React / Next.js]
        Mobile[Mobile Client]
    end

    subgraph Platform[Application Platform]
        Gateway[API Gateway
        Auth, rate limits, routing]
        BFF[Backend-for-Frontend]
        Queue[Message Queue]
    end

    subgraph Services[Domain Services]
        Identity[Identity Service]
        Catalog[Catalog Service]
        Orders[Order Service]
        Billing[Billing Service]
        Notify[Notification Worker]
    end

    subgraph Data[Data & Integrations]
        SQL[(PostgreSQL
        transactional data)]
        Cache[(Redis
        cache / sessions)]
        Object[(Object Storage
        media / documents)]
        Search[(Search Index)]
        Stripe[Payment Provider]
        Email[Email / SMS Provider]
    end

    subgraph Ops[Observability & Operations]
        Logs[Centralized Logs]
        Metrics[Metrics + Alerts]
        Traces[Distributed Tracing]
        CI[CI/CD Pipeline]
    end

    User --> DNS --> CDN
    User --> WAF
    CDN --> Web
    WAF --> Web
    WAF --> Mobile
    Web --> Gateway
    Mobile --> Gateway
    Gateway --> BFF
    BFF --> Identity
    BFF --> Catalog
    BFF --> Orders
    BFF --> Billing

    Identity --> SQL
    Identity --> Cache
    Catalog --> SQL
    Catalog --> Cache
    Catalog --> Search
    Catalog --> Object
    Orders --> SQL
    Orders --> Queue
    Billing --> SQL
    Billing --> Stripe
    Queue --> Notify
    Notify --> Email

    Gateway -. telemetry .-> Logs
    BFF -. telemetry .-> Traces
    Services -. metrics .-> Metrics
    CI -. deploys .-> CDN
    CI -. deploys .-> Platform
    CI -. deploys .-> Services

    classDef user fill:#f5f0ff,stroke:#7b55c7,color:#2d2050
    classDef edge fill:#e8f1ff,stroke:#3973c6,color:#10233f
    classDef app fill:#eefbf4,stroke:#3a9b68,color:#123d27
    classDef data fill:#fff7e6,stroke:#d38b24,color:#573708
    classDef ops fill:#f1f3f5,stroke:#687784,color:#26323b

    class User user
    class DNS,CDN,WAF edge
    class Web,Mobile,Gateway,BFF,Queue,Identity,Catalog,Orders,Billing,Notify app
    class SQL,Cache,Object,Search,Stripe,Email data
    class Logs,Metrics,Traces,CI ops
