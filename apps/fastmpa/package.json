{
  "name": "fastmpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FastMPA Windows Desktop application",
  "author": "FastMPA contributors",
  "repository": "https://github.com/ShawnDen-coder/fastmpa.git",
  "main": "dist/main/main.mjs",
  "files": ["dist", "resources"],
  "scripts": {
    "build": "vite build --config vite.renderer.config.ts && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "dev:renderer": "vite --config vite.renderer.config.ts --host localhost --strictPort",
    "dev:electron": "electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:smoke": "node scripts/desktop-host-smoke.mjs",
    "desktop:package-smoke": "node scripts/desktop-package-smoke.mjs",
    "check": "biome check .",
    "format": "biome format --write .",
    "package:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.12.6",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3",
    "@shawnden-coder/agent-core": "workspace:*",
    "@shawnden-coder/agent-runtime": "workspace:*",
    "workspace": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "io.fastmpa.desktop",
    "productName": "FastMPA",
    "icon": "resources/icon.ico",
    "asar": true,
    "npmRebuild": true,
    "publish": null,
    "asarUnpack": ["**/node_modules/better-sqlite3/**/*"],
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": { "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "artifactName": "FastMPA-Setup-${version}.exe" }
  }
}
