{
  "name": "agent-core",
  "version": "0.2.0",
  "type": "module",
  "description": "core",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test:openrouter": "pnpm build && node --env-file=../../.env scripts/openrouter-smoke.mjs",
    "test:openrouter:turn": "pnpm build && node --env-file=../../.env scripts/openrouter-turn-smoke.mjs",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
