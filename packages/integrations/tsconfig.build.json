{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo/tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../agent-core/tsconfig.build.json" },
    { "path": "../tool-pipeline/tsconfig.build.json" }
  ],
  "include": ["src"]
}
