{
  "name": "agent-runtime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "agent-core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
