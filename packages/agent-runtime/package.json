{
  "name": "agent-runtime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "agent-core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  }
}
